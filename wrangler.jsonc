{
  "\"$schema\"": "./node_modules/wrangler/config-schema.json",
  "name": "submit",
  "main": "functions/api/submit.js",
  "pages_build_output_dir": "_site",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2026-02-04",
  "assets": {
    "directory": "_site",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}